{
  "scripts": {
    "Buzz 시작": {
      "type": "script",
      "command": "npm.cmd --prefix buzz-bridge start"
    },
    "Buzz 상태": {
      "type": "script",
      "command": "npm.cmd --prefix buzz-bridge run status"
    },
    "Buzz 종료": {
      "type": "script",
      "command": "npm.cmd --prefix buzz-bridge stop"
    },
    "Bridge 테스트": {
      "type": "script",
      "command": "npm.cmd --prefix buzz-bridge test"
    }
  }
}
